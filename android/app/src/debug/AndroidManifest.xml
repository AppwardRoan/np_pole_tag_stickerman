<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission is required for development. Specifically,
         the Flutter tool needs it to communicate with the running application
         to allow setting breakpoints, to provide hot reload, etc.
    -->
    <uses-permission android:name="android.permission.INTERNET"/>

    <!-- Android 9+ blocks unencrypted HTTP. The deployed API is https, but the
         env 2 and env 3 addresses in api_config.dart are plain http against a
         uvicorn on the dev machine, and without this every request fails as
         "could not reach the server".

         Debug manifest only, so the release build keeps the platform default
         and cannot silently ship cleartext. -->
    <application android:usesCleartextTraffic="true" />
</manifest>
